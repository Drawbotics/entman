    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "redux": "^3.5.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/eslint-parser": "^7.24.0",
    "@babel/plugin-proposal-export-default-from": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^30",
    "babel-loader": "^10",
    "deep-freeze": "0.0.1",
    "eslint": "^8.57.0",
    "jest": "^30",
    "redux": "^3.5.2",
    "rimraf": "^5.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^6"
  },
  "dependencies": {
    "normalizr": "^3.2.1",
    "redux-batched-actions": "^0.1.5",
    "uuid": "^3.0.1"
